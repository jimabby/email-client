PORT=3001
NODE_ENV=development

# Interface to listen on. Defaults to 127.0.0.1 in development, 0.0.0.0 in
# production. Without an API_TOKEN the API is unauthenticated, so the server
# REFUSES to bind anything other than loopback — that combination would expose
# every connected mailbox to the local network.
# BIND_HOST=127.0.0.1

# Required in production, and required for any non-loopback BIND_HOST.
# Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-bytes

# Encrypts stored credentials (IMAP passwords, OAuth refresh tokens, AI keys)
# at rest. The packaged desktop app derives this from the OS keychain and sets
# it automatically; set it yourself only for a server deployment.
# Generate with: openssl rand -hex 32
# WARNING: changing or losing this makes existing stored credentials
# unreadable. They are left sealed on disk, so restoring the original value
# recovers them — otherwise the passwords and API keys must be re-entered.
# HERMES_SECRET_KEY=

# Comma-separated browser origins. Native mobile requests have no Origin header.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# Public URL used after OAuth completes.
FRONTEND_URL=http://localhost:3001

# /api/emails/trigger-report sends real mail, so it is disabled when
# NODE_ENV=production unless this is explicitly set.
# HERMES_ALLOW_TRIGGER_REPORT=false

# Anthropic Claude API (required for AI suggestions)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth (optional - for Gmail accounts)
# Create at https://console.cloud.google.com/apis/credentials
# Enable Gmail API and create OAuth 2.0 credentials
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Outlook / Microsoft OAuth (optional - for Outlook/Hotmail accounts)
# Create at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Register app with Mail.ReadWrite and Mail.Send permissions
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# Optional instant push delivery. Without these Hermes falls back to API polling.
# Gmail push requires TWO things on the Pub/Sub topic below:
#   1. Grant gmail-api-push@system.gserviceaccount.com publish access to the topic.
#   2. Create a PUSH subscription on the topic whose endpoint is
#      https://<your-public-host>/api/webhooks/gmail  (Gmail delivers here).
# The topic name is set here; the subscription is created in the Cloud console/CLI.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/hermes-mail
# Optional: authenticate Gmail push. If set, the endpoint requires a Google-signed
# OIDC token whose email matches this service account (configure the subscription
# with an OIDC push auth token). Leave unset to accept unauthenticated pushes.
GMAIL_PUBSUB_SA_EMAIL=
# GMAIL_PUBSUB_AUDIENCE=https://mail.example.com/api/webhooks/gmail
# Outlook: public HTTPS origin forwarding to this backend, plus a random secret.
PUBLIC_WEBHOOK_URL=https://mail.example.com
WEBHOOK_CLIENT_STATE=replace-with-a-long-random-secret

# NOTE: For Gmail without OAuth, use IMAP with an App Password:
# 1. Enable 2FA on your Google account
# 2. Go to Google Account > Security > App passwords
# 3. Create an app password and use it when adding IMAP account
# IMAP Host: imap.gmail.com, Port: 993
# SMTP Host: smtp.gmail.com, Port: 587
