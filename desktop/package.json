{
  "name": "hermes",
  "version": "1.0.0",
  "description": "Hermes — Desktop Email Client with AI",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "start": "electron .",
    "make-icon": "node scripts/make-icon.js",
    "build:frontend": "cd frontend && npm run build",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@azure/msal-node": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "imapflow": "^2.1.1",
    "mailparser": "^3.9.30",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.12",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.hermes.app",
    "productName": "Hermes",
    "copyright": "Copyright © 2025 Hermes",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "!backend/.env",
      "!backend/.env.*",
      "!backend/**/accounts.json",
      "!backend/**/*.key",
      "!backend/**/email-cache.json",
      "!backend/**/categories.json",
      "!backend/**/search-index.json",
      "!backend/**/outbox.json",
      "!backend/**/*.unreadable-*",
      "!backend/**/*.tmp",
      "!backend/test/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/512x512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons/"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    }
  }
}
