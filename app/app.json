{
  "expo": {
    "name": "Hermes",
    "slug": "hermes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#060609"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.mobile"
    },
    "android": {
      "package": "com.hermes.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#060609"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#fbbf24"
        }
      ]
    ]
  }
}
