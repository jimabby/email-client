{
  "name": "hermes-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand && node --test test/*.test.cjs",
    "postinstall": "node ../scripts/patch-tooling.cjs",
    "test:security": "node ../scripts/patch-tooling.cjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.20.0",
    "dom-serializer": "^1.4.1",
    "expo": "~57.0.30",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "htmlparser2": "^7.2.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  }
}
