# A DNS A/AAAA record for this name must point to the VPS.
HERMES_DOMAIN=mail.example.com

# Generate independently with: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-value
SESSION_SECRET=replace-with-a-different-long-random-value

ALLOWED_ORIGINS=https://mail.example.com
FRONTEND_URL=https://mail.example.com

# Optional AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://mail.example.com/api/auth/gmail/callback

# Optional Outlook OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://mail.example.com/api/auth/outlook/callback

# Optional provider push notifications
GMAIL_PUBSUB_TOPIC=
PUBLIC_WEBHOOK_URL=https://mail.example.com
WEBHOOK_CLIENT_STATE=replace-with-another-long-random-value
