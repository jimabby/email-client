# A DNS A/AAAA record for this name must point to the VPS.
HERMES_DOMAIN=mail.example.com

# Generate independently with: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-value

# Encrypts stored credentials at rest (IMAP passwords, OAuth refresh tokens,
# AI keys). Generate with: openssl rand -hex 32
#
# BACK THIS UP. If it changes, existing credentials become unreadable — they
# stay sealed on disk rather than being destroyed, so restoring the original
# value recovers them, but without it every account must be re-authorised.
HERMES_SECRET_KEY=replace-with-another-long-random-value

ALLOWED_ORIGINS=https://mail.example.com
FRONTEND_URL=https://mail.example.com

# Optional AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://mail.example.com/api/auth/gmail/callback

# Optional Outlook OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://mail.example.com/api/auth/outlook/callback

# Optional provider push notifications.
# Gmail also needs a Pub/Sub PUSH subscription on this topic pointing at
# https://mail.example.com/api/webhooks/gmail (create it in the Cloud console).
GMAIL_PUBSUB_TOPIC=
# Optional: require a Google-signed OIDC token on Gmail pushes (set the
# subscription's OIDC auth service-account email to match).
GMAIL_PUBSUB_SA_EMAIL=
# GMAIL_PUBSUB_AUDIENCE=https://mail.example.com/api/webhooks/gmail
PUBLIC_WEBHOOK_URL=https://mail.example.com
WEBHOOK_CLIENT_STATE=replace-with-another-long-random-value
